                                                                                                                                    "patching_rect": [ 93.0, 503.0, 280.0, 29.0 ],
                                                                                                                                    "text": "void Jacobi(Surface pressure, Surface divergence, Surface obstacles, Surface dest);"
                                                                                                                                }
                                                                                                                            },
